<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>/Users/leminhson</string>
		<key>PATH</key>
		<string>/Users/leminhson/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
	<key>Label</key>
	<string>com.intel.weekly</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/uv</string>
		<string>run</string>
		<string>--project</string>
		<string>/Users/leminhson/freelance/market-intel</string>
		<string>intel</string>
		<string>weekly</string>
	</array>
	<key>StandardErrorPath</key>
	<string>/Users/leminhson/freelance/market-intel/logs/com.intel.weekly.err.log</string>
	<key>StandardOutPath</key>
	<string>/Users/leminhson/freelance/market-intel/logs/com.intel.weekly.out.log</string>
	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Hour</key>
			<integer>7</integer>
			<key>Minute</key>
			<integer>45</integer>
			<key>Weekday</key>
			<integer>1</integer>
		</dict>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/leminhson/freelance/market-intel</string>
</dict>
</plist>
